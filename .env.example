PORT=3478
# Comma-separated browser origins for local and public deployments.
CLIENT_ORIGIN=http://localhost:5173,https://cucekconnect.com
JWT_SECRET=replace-with-a-long-random-secret
OWNER_NAME_PASSWORD=replace-with-a-strong-private-password
# URL-encode special characters in the database password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DB=cucek_connect
# Required for multiple backend instances. Use a managed Redis endpoint in production.
REDIS_URL=redis://<redis-host>:6379
STUN_URL=stun:stun.l.google.com:19302
# Required for restrictive networks when using the built-in WebRTC fallback.
VITE_SERVER_URL=turn:your-turn-server.example:3478
VITE_TURN_USERNAME=replace-with-turn-username
VITE_TURN_PASSWORD=replace-with-turn-password
